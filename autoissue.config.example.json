{
  "project": {
    "repo": "owner/repo-name",
    "path": "/path/to/project",
    "baseBranch": "main"
  },
  "executor": {
    "maxParallel": 3,
    "timeoutMinutes": 30,
    "createPr": true,
    "prDraft": false,
    "verifyCommand": "npm test",
    "verifyTimeoutMinutes": 20,
    "verifyBaseline": true,
    "skipIssuesWithOpenPr": true,
    "branchTemplate": "autoissue/issue-{issue}"
  },
  "agent": {
    "engines": ["codex", "claude"],
    "tier": "auto",
    "codexModels": {
      "simple": { "model": "gpt-6-luna", "effort": "medium" },
      "medium": { "model": "gpt-6.1-sol", "effort": "medium" },
      "complex": { "model": "gpt-6-astra", "effort": "high" }
    },
    "claudeModels": { "simple": "haiku", "medium": "sonnet", "complex": "opus" },
    "maxBudgetUsd": 5.0,
    "yolo": true
  },
  "maxTotalBudgetUsd": 50.0,
  "dashboard": {
    "enabled": true,
    "port": 3030,
    "auth": {
      "enabled": true,
      "type": "both",
      "username": "admin",
      "password": "change-me-in-production",
      "token": "generate-a-secure-token-here"
    }
  },
  "planner": {
    "enabled": true,
    "model": "sonnet",
    "maxBudgetUsd": 2.0
  }
}
